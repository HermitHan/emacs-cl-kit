;;; verify-startup.el --- Load and check an isolated installation offline -*- lexical-binding: t -*-
;; HOME=<temporary HOME containing the installation> [HAN_EXPECT_DEFAULT=sbcl]
;; emacs -Q --batch -l tests/verify-startup.el
(load (expand-file-name "test-sandbox.el" (file-name-directory load-file-name)) nil t)
(portable-test-prepare)
(require 'ert)
(defvar portable-forbidden-calls nil)
(defvar portable-test-preview-request nil)
(defun portable-deny (action &rest _)
  (push action portable-forbidden-calls)
  (error "Unexpected offline startup operation: %s" action))
(dolist (fn '(package-refresh-contents package-install make-network-process open-network-stream
              url-retrieve url-retrieve-synchronously auth-source-search
              gptel-openai-oauth-login gptel--openai-oauth-ensure gptel--openai-oauth-refresh
              gptel-oauth--read gptel-oauth--write slime slime-connect))
  (advice-add fn :override (apply-partially #'portable-deny fn)))
(advice-add 'gptel-request :before
            (lambda (&optional _prompt &rest options)
              (unless (and portable-test-preview-request (plist-get options :dry-run))
                (portable-deny 'gptel-request))))
;; Suppress effects of a normal GUI/user session, without replacing package loading.
(advice-add 'server-running-p :override (lambda (&rest _) t))
(advice-add 'server-start :override #'ignore)
(advice-add 'desktop-read :override #'ignore)
(advice-add 'exec-path-from-shell-initialize :override #'ignore)
(advice-add 'envrc-global-mode :override #'ignore)
(advice-add 'flymake-start :override #'ignore)
(setq before-init-time (current-time))
(load (expand-file-name "early-init.el" user-emacs-directory) nil t)
(load user-init-file nil t)
(setq after-init-time (current-time))
(run-hooks 'after-init-hook)
(run-hooks 'emacs-startup-hook)
(dolist (feat '(slime slime-repl gptel gptel-openai-oauth gptel-rewrite))
  ;; slime-repl is in the package's contrib/ subdirectory.
  (portable-test-installed feat))

(ert-deftest portable-startup-and-installed-libraries ()
  (should (equal (file-truename package-user-dir) (file-truename (portable-test-elpa))))
  (dolist (feat '(init init-state init-common-lisp init-slime init-gptel init-gptel-workflow
                  init-gptel-preferences init-gptel-response-guard))
    (should (featurep feat)))
  (should (eq gptel-model 'gpt-5.6-sol))
  (should (equal (gptel-backend-name gptel-backend) "ChatGPT subscription"))
  (should (equal gptel--openai-oauth-token-file
                 (expand-file-name ".cache/gptel-openai/openai-oauth-token" user-emacs-directory)))
  (should-not (file-exists-p gptel--openai-oauth-token-file))
  (should (equal han/gptel-preferences-file (expand-file-name "gptel-preferences.md" user-emacs-directory)))
  (should (memq #'han/gptel--inject-preferences gptel-prompt-transform-functions))
  (should-not slime-net-processes)
  (should-not portable-forbidden-calls))

(ert-deftest portable-cl-and-gptel-keys ()
  (with-temp-buffer
    (lisp-mode)
    (should slime-mode) (should paredit-mode) (should aggressive-indent-mode)
    (dolist (pair '(("C-c C-c" . slime-compile-defun) ("C-c C-k" . slime-compile-and-load-file)
                    ("C-c C-r" . slime-eval-region) ("C-c C-z" . slime-switch-to-output-buffer)
                    ("M-." . slime-edit-definition) ("C-c r" . gptel-rewrite)))
      (should (eq (key-binding (kbd (car pair))) (cdr pair))))
    (should (equal (lookup-key key-translation-map (kbd "M--")) (kbd "C-x u"))))
  (with-temp-buffer
    (slime-repl-mode)
    (should (memq (key-binding (kbd "RET")) '(newline paredit-RET)))
    (should (eq (key-binding (kbd "M-RET")) 'slime-repl-return)))
  (should (eq (lookup-key gptel-mode-map (kbd "C-c j n")) 'han/gptel-next-message))
  (should (eq (lookup-key gptel-mode-map (kbd "C-c j u")) 'han/gptel-user-message))
  (dolist (pair '(("a" . han/gptel-review-accept) ("k" . han/gptel-review-reject)
                  ("r" . han/gptel-review-iterate) ("y" . han/gptel-review-copy-candidate)
                  ("Y" . han/gptel-review-copy-original)))
    (should (eq (lookup-key han/gptel-review-mode-map (kbd (car pair))) (cdr pair)))))

(ert-deftest portable-gptel-chat-language-and-template ()
  ;; Use the same inspector entry as the chat menu.  It assembles the actual
  ;; backend payload but never sends it or opens the account's token file.
  (require 'gptel-transient)
  (with-temp-buffer
    (markdown-mode)
    (gptel-mode 1)
    (let ((question "How does this Common Lisp function work?")
          (gptel-track-media nil)
          (gptel-system-prompt '("Chat directive" "Earlier question" "Earlier answer"))
          (process-environment (copy-sequence process-environment))
          (han/gptel-response-language nil)
          (han/gptel-preferences-file (expand-file-name "absent-preferences.md" temporary-file-directory))
          (portable-test-preview-request t))
      (insert question)
      (setenv "LC_MESSAGES" "zh_CN.UTF-8")
      (setenv "LANG" "de_DE.UTF-8")
      (dolist (locale '(("zh-CN" nil) ("en" "C")))
        (setenv "LC_ALL" (cadr locale))
        (let* ((fsm (gptel--suffix-send '("I")))
               (data (plist-get (gptel-fsm-info fsm) :data))
               (system (plist-get data :instructions)))
          (should (string-prefix-p "Chat directive" system))
          (should (string-search "latest natural-language question or rewrite instruction" system))
          (should (string-search (concat "fallback: " (car locale)) system))
          (should (equal (mapcar (lambda (msg) (plist-get msg :content)) (plist-get data :input))
                         (list "Earlier question" "Earlier answer" question)))
          (should (equal (buffer-string) question)))))))

(ert-deftest portable-gptel-rewrite-language-and-format ()
  (with-temp-buffer
    (emacs-lisp-mode)
    (let ((code "(defun plus-two (n) (+ n 2))")
          (instruction "请补上文档字符串。")
          (gptel-track-media nil)
          (han/gptel-response-language "French")
          (preferences (make-temp-file "han-rewrite-style-" nil ".md" "Prefer short functions."))
          (portable-test-preview-request t))
      (unwind-protect
          (let ((han/gptel-preferences-file preferences))
            (insert code)
            (set-mark (point-max))
            (goto-char (point-min))
            (setq mark-active t)
            (let* ((fsm (gptel--suffix-rewrite instruction t))
                   (info (gptel-fsm-info fsm))
                   (data (plist-get info :data))
                   (system (plist-get data :instructions))
                   (messages (plist-get data :input)))
              (kill-buffer (cdr (plist-get info :context)))
              (should (string-search "Generate ONLY" system))
              (should (string-search "explicit language or translation request" system))
              (should (string-search "preferred language: French" system))
              (should (string-search "Prefer short functions." system))
              (should (equal (plist-get (aref messages 0) :content) code))
              (should (equal (plist-get (aref messages 2) :content) instruction))
              (should (equal (buffer-string) code))))
        (delete-file preferences)))))

(ert-deftest portable-installer-preference ()
  (let ((expected (getenv "HAN_EXPECT_DEFAULT")))
    (when expected
      (should (equal (symbol-name slime-default-lisp) expected))))
  ;; Exercise the real module's env > saved name > SBCL priority without
  ;; modifying the installer's choice or depending on a second installed Lisp.
  (let* ((module (expand-file-name "lisp/init-common-lisp.el" user-emacs-directory))
         (user-emacs-directory (file-name-as-directory (make-temp-file "slime-priority-" t)))
         (saved (expand-file-name "var/slime-default-lisp" user-emacs-directory))
         (exec-path (list user-emacs-directory))
         (process-environment (copy-sequence process-environment))
         (slime-default-lisp nil) (slime-lisp-implementations nil))
    (make-directory (file-name-directory saved) t)
    (setenv "LISPWORKS" nil)
    (dolist (name '("sbcl" "my-lispworks" "ccl"))
      (let ((file (expand-file-name name user-emacs-directory)))
        (with-temp-file file (insert "#!/bin/sh\nexit 1\n"))
        (set-file-modes file #o700)))
    (dolist (case '((nil "my-lispworks" my-lispworks)
                    ("ccl" "my-lispworks" ccl)
                    ("missing" "my-lispworks" my-lispworks)
                    (nil "missing" sbcl)))
      (with-temp-file saved (insert (nth 1 case) "\n"))
      (setenv "SLIME_DEFAULT_LISP" (car case))
      (load module nil t)
      (should (eq slime-default-lisp (nth 2 case))))))

(let ((stats (ert-run-tests-batch "^portable-")))
  (setq kill-emacs-hook nil)
  (kill-emacs (if (or portable-forbidden-calls (> (ert-stats-completed-unexpected stats) 0)) 1 0)))
