#!/usr/bin/env bash
# Run with bash, either from a file or directly from a curl pipeline.
set -eu
# Bash parses the entire group before executing it, including the final brace.
# A transfer cut off just after the Python source must not start an installation.
trap 'echo "Incomplete installer. Download it again." >&2; exit 1' EXIT
{
  trap - EXIT
  command -v python3 >/dev/null || { echo 'Python 3.8+ is required.' >&2; exit 1; }
  exec python3 - "${BASH_SOURCE[0]-}" "$@" 3<&0 <<'HAN_INSTALLER_PYTHON'
import base64
import hashlib
import io
import os
from pathlib import Path, PurePosixPath
import shutil
import subprocess
import sys
import tarfile
import tempfile

if sys.version_info < (3, 8):
    sys.exit("Python 3.8+ is required.")
payload = base64.b64decode(b"""@ARCHIVE_BASE64@""")
if hashlib.sha256(payload).hexdigest() != "@ARCHIVE_SHA256@":
    sys.exit("Archive checksum mismatch. Download the installer again.")

with tempfile.TemporaryDirectory(prefix="emacs-portable-") as work:
    root = Path(work)
    with tarfile.open(fileobj=io.BytesIO(payload), mode="r:gz") as archive:
        for member in archive:
            name = PurePosixPath(member.name)
            if (not member.isfile() or len(name.parts) < 2 or name.parts[0] != "emacs-portable"
                    or ".." in name.parts or str(name) != member.name):
                sys.exit("Invalid entry in release archive.")
            dest = root / name
            dest.parent.mkdir(parents=True, exist_ok=True)
            with dest.open("xb") as output:
                shutil.copyfileobj(archive.extractfile(member), output)
            dest.chmod(0o755 if member.mode & 0o111 else 0o644)
    entry = root / "emacs-portable" / "install.sh"
    filename = sys.argv[1]
    env = dict(os.environ, HAN_INSTALLER_FILE=str(Path(filename).resolve()) if filename else "")
    with os.fdopen(3, "rb") as original_input:
        # The backend picker opens /dev/tty itself, including for interactive SSH.
        stdin = original_input if filename else subprocess.DEVNULL
        result = subprocess.run(["bash", str(entry), *sys.argv[2:]], stdin=stdin, env=env)
sys.exit(result.returncode)
HAN_INSTALLER_PYTHON
}
